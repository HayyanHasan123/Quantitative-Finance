import pandas as pd
import numpy as np
import matplotlib.pyplot as plt
import seaborn as sns
from statsmodels.tsa.arima.model import ARIMA
import yfinance as yf
from datetime import datetime, timedelta
import warnings
warnings.filterwarnings('ignore')

print("All libraries imported successfully!")

# Step 1: Download NVDA stock data
print("\nDownloading NVDA stock data...")
nvda = yf.download('NVDA', start='2024-01-01', end='2025-12-31', progress=False)

# Fix multi-index columns issue
if isinstance(nvda.columns, pd.MultiIndex):
    nvda.columns = nvda.columns.droplevel(1)

nvda.index = pd.to_datetime(nvda.index)

print(f"Downloaded {len(nvda)} days of NVDA data")
print(f"Date range: {nvda.index[0]} to {nvda.index[-1]}")

# Step 2: Define earnings announcement dates
# These are typical NVDA quarterly earnings dates
earnings_dates_2025 = [
    '2025-02-26', '2025-05-28', '2025-08-27', '2025-11-19'
]

earnings_dates_2026 = [
    '2026-02-25', '2026-05-27', '2026-08-26', '2026-11-18'
]

# Step 3: Calculate percentage changes around earnings dates
def calculate_earnings_impact(df, dates, window=1):
    """
    Calculate percentage change around earnings dates
    window: number of days before/after to measure impact
    """
    results = []
    
    for date_str in dates:
        date = pd.to_datetime(date_str)
        
        # Find the closest trading day to the announcement date
        if date in df.index:
            announcement_date = date
        else:
            # Get the next available trading day
            future_dates = df.index[df.index >= date]
            if len(future_dates) > 0:
                announcement_date = future_dates[0]
            else:
                continue
        
        # Get the date before announcement
        try:
            date_idx = df.index.get_loc(announcement_date)
            if date_idx > 0:
                previous_date = df.index[date_idx - 1]
                
                # Calculate percentage change - handle both Series and scalar
                prev_close = df.loc[previous_date, 'Close']
                current_close = df.loc[announcement_date, 'Close']
                
                # Convert to float if needed
                if hasattr(prev_close, 'item'):
                    prev_close = prev_close.item()
                if hasattr(current_close, 'item'):
                    current_close = current_close.item()
                
                pct_change = ((current_close - prev_close) / prev_close) * 100
                
                results.append({
                    'Date': announcement_date,
                    'Percentage_Change': float(pct_change),
                    'Close': float(current_close)
                })
        except Exception as e:
            print(f"Error processing {date_str}: {e}")
            continue
    
    return pd.DataFrame(results).set_index('Date')

# Calculate actual 2025 impacts
print("\nCalculating 2025 earnings impacts...")
nvda_impact_2025_df = calculate_earnings_impact(nvda, earnings_dates_2025)

print("\n2025 NVDA Earnings Impact:")
print(nvda_impact_2025_df)

# Step 4: Prepare data for ARIMA model
target_variable = nvda_impact_2025_df['Percentage_Change']

print(f"\nTarget variable length: {len(target_variable)}")
print(f"Mean percentage change: {target_variable.mean():.2f}%")
print(f"Std deviation: {target_variable.std():.2f}%")

# Step 5: Fit ARIMA model
# ARIMA(p,d,q) where p=autoregressive terms, d=differencing, q=moving average
print("\nFitting ARIMA model...")

# For small datasets, ARIMA(1,0,1) or ARIMA(1,1,1) works well
try:
    arima_model = ARIMA(target_variable, order=(1, 0, 1))
    arima_model_fit = arima_model.fit()
    
    print("ARIMA Model Summary:")
    print(arima_model_fit.summary())
except Exception as e:
    print(f"Error fitting ARIMA(1,0,1), trying simpler model...")
    arima_model = ARIMA(target_variable, order=(1, 0, 0))
    arima_model_fit = arima_model.fit()
    print("Using ARIMA(1,0,0) model")

# Step 6: Make predictions for 2026
print("\n" + "="*60)
print("Making 2026 Predictions")
print("="*60)

dates_2026_dt = pd.to_datetime(earnings_dates_2026)

if len(dates_2026_dt) > 0:
    forecast_periods = len(dates_2026_dt)
    
    # The model continues from where the training data ended
    start_point = len(target_variable)
    end_point = start_point + forecast_periods - 1
    
    # Get forecasted values
    forecasted_values = arima_model_fit.predict(start=start_point, end=end_point)
    
    # Build the forecast dataframe
    nvda_forecast_2026_df = pd.DataFrame({
        'Predicted_Percentage_Change': forecasted_values.values
    }, index=dates_2026_dt)
    
    print("\nNVDA Stock Price Movement Predictions for 2026 Earnings Dates:")
    print(nvda_forecast_2026_df)
    print("\nSummary Statistics:")
    print(nvda_forecast_2026_df.describe())
    
    # Investment recommendation
    avg_prediction = nvda_forecast_2026_df['Predicted_Percentage_Change'].mean()
    print(f"\nAverage Predicted Change: {avg_prediction:.2f}%")
    
    if avg_prediction > 2:
        print("📈 Recommendation: BUY - Strong positive momentum expected")
    elif avg_prediction < -2:
        print("📉 Recommendation: SELL - Negative momentum expected")
    else:
        print("➡️  Recommendation: HOLD - Sideways movement expected")
else:
    print("No earnings dates available for 2026 predictions.")

# Step 7: Visualization
print("\nGenerating visualizations...")

plt.figure(figsize=(14, 7))

# Plot 2025 actual data
plt.plot(nvda_impact_2025_df.index, 
         nvda_impact_2025_df['Percentage_Change'], 
         label='2025 Actual % Change',
         marker='o',
         linewidth=2.5,
         markersize=10,
         color='#76B900')  # NVIDIA green

# Plot 2026 predictions
plt.plot(nvda_forecast_2026_df.index, 
         nvda_forecast_2026_df['Predicted_Percentage_Change'], 
         label='2026 Predicted % Change',
         marker='s',
         linestyle='--',
         linewidth=2.5,
         markersize=10,
         color='#1A1A1A')  # Dark gray

# Add zero line
plt.axhline(y=0, color='gray', linestyle='-', alpha=0.3, linewidth=1)

plt.title('NVDA Stock Percentage Change: 2025 Actual vs 2026 Forecast', 
          fontsize=16, fontweight='bold', pad=20)
plt.xlabel('Earnings Announcement Date', fontsize=12, fontweight='bold')
plt.ylabel('Percentage Change (%)', fontsize=12, fontweight='bold')
plt.legend(fontsize=11, loc='best', framealpha=0.9)
plt.grid(True, alpha=0.3, linestyle=':')
plt.xticks(rotation=45)
plt.tight_layout()
plt.show()

# Step 8: Forecast with confidence intervals
print("\nGenerating forecast with confidence intervals...")

forecast_obj = arima_model_fit.get_forecast(steps=forecast_periods)
forecast_df = forecast_obj.summary_frame()

plt.figure(figsize=(14, 7))

# Plot actual data
plt.plot(nvda_impact_2025_df.index, 
         nvda_impact_2025_df['Percentage_Change'], 
         label='2025 Actual', 
         marker='o', 
         linewidth=2.5, 
         markersize=10,
         color='#76B900')

# Plot forecast
plt.plot(dates_2026_dt, 
         forecasted_values, 
         label='2026 Forecast', 
         marker='s', 
         linestyle='--', 
         linewidth=2.5,
         markersize=10,
         color='#1A1A1A')

# Add confidence interval
plt.fill_between(dates_2026_dt, 
                 forecast_df['mean_ci_lower'], 
                 forecast_df['mean_ci_upper'], 
                 alpha=0.2, 
                 color='gray', 
                 label='95% Confidence Interval')

plt.axhline(y=0, color='gray', linestyle='-', alpha=0.3, linewidth=1)
plt.title('NVDA Stock Forecast with 95% Confidence Intervals', 
          fontsize=16, fontweight='bold', pad=20)
plt.xlabel('Date', fontsize=12, fontweight='bold')
plt.ylabel('Percentage Change (%)', fontsize=12, fontweight='bold')
plt.legend(fontsize=11, framealpha=0.9)
plt.grid(True, alpha=0.3, linestyle=':')
plt.xticks(rotation=45)
plt.tight_layout()
plt.show()

print("\n" + "="*60)
print("Analysis Complete!")
print("="*60)